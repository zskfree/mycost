# ==========================================
# MyCost 环境变量模板 (复制为 .env 使用)
# ==========================================

# 前端请求 API 根路径。本地/Pages 同域默认可不填
VITE_API_BASE_URL=/api/v1

# 你的自建 One API 根地址 (例如: http://your-ip:3000/v1)
ONE_API_BASE_URL=https://api.your-one-api.com/v1

# 在 One API 控制台生成的专属应用 Token
ONE_API_KEY=sk-mycost-prod-xxxxxx

# 阶梯原生音频多模态大模型
MULTIMODAL_MODELS=gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.6-flash

# 独立纯语音转写 STT 模型
TRANSCRIBE_MODEL=gemini-3.5-transcribe

# Cloudflare 后端个人访问 Passkey 令牌
APP_PASSKEY=my_secure_passkey_2026
